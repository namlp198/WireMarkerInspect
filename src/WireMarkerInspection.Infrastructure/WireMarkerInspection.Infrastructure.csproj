<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <MvsManagedSdkPath Condition="Exists('../../vendor/camera/MvCameraControl.Net.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../vendor/camera/MvCameraControl.Net.dll'))</MvsManagedSdkPath>
    <MvsManagedSdkPath Condition="'$(MvsManagedSdkPath)' == '' and Exists('$(MSBuildProgramFiles32)/MVS/Development/DotNet/AnyCpu/MvCameraControl.Net.dll')">$(MSBuildProgramFiles32)/MVS/Development/DotNet/AnyCpu/MvCameraControl.Net.dll</MvsManagedSdkPath>
    <DefineConstants Condition="'$(MvsManagedSdkPath)' != ''">$(DefineConstants);HIKROBOT_MVS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WireMarkerInspection.Domain/WireMarkerInspection.Domain.csproj" />
    <ProjectReference Include="../WireMarkerInspection.Application/WireMarkerInspection.Application.csproj" />
    <PackageReference Include="NModbus" />
    <PackageReference Include="NModbus.Serial" />
    <Reference Include="MvCameraControl.Net" HintPath="$(MvsManagedSdkPath)" Private="true" Condition="'$(MvsManagedSdkPath)' != ''" />
  </ItemGroup>
</Project>

