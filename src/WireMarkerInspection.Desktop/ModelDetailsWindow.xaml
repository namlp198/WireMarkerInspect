<Window x:Class="WireMarkerInspection.Desktop.ModelDetailsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Model" Width="430" Height="290" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Brush.Background.App}" Foreground="{StaticResource Brush.Text.Primary}" FontFamily="{StaticResource Font.Primary}">
 <Border Style="{StaticResource Panel}" Margin="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}"/>
   <TextBox Grid.Row="1" Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" ToolTip="Mã model duy nhất" AutomationProperties.Name="Mã model" Margin="0,0,0,10"/>
   <TextBox Grid.Row="2" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" ToolTip="Tên model" AutomationProperties.Name="Tên model"/>
   <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="{StaticResource Brush.Status.Error}" TextWrapping="Wrap" MinHeight="18" Margin="0,8,0,0"/>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
    <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Close}" ToolTip="Hủy" AutomationProperties.Name="Hủy" IsCancel="True" Margin="0,0,6,0"/>
    <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Check}" ToolTip="Xác nhận" AutomationProperties.Name="Xác nhận" IsDefault="True" Click="Done"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
