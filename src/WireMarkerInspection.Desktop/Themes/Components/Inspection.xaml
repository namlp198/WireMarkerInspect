<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:WireMarkerInspection.Controls;assembly=WireMarkerInspection.Controls">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Tokens/_Tokens.xaml"/>
  <ResourceDictionary Source="Buttons.xaml"/>
  <ResourceDictionary Source="Inputs.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Thickness x:Key="Layout.PagePadding">16</Thickness>
 <Thickness x:Key="Layout.PanelPadding">12</Thickness>
 <Thickness x:Key="Layout.ControlGap">0,0,6,0</Thickness>
 <LinearGradientBrush x:Key="Brush.Taskbar.Normal" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#F4F4F4" Offset="0"/><GradientStop Color="#A9ACB1" Offset="0.48"/><GradientStop Color="#E7E7E7" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="Brush.Taskbar.Active" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#F8FEFF" Offset="0"/><GradientStop Color="#A7C8C9" Offset="0.5"/><GradientStop Color="#E9FFFF" Offset="1"/>
 </LinearGradientBrush>
 <Style x:Key="Hud.Container" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Brush.Overlay.Widget}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Brush.Overlay.PanelBorder}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}"/>
  <Setter Property="Effect" Value="{StaticResource Elevation.Overlay}"/>
 </Style>
 <Style x:Key="Hud.Separator" TargetType="Border">
  <Setter Property="Height" Value="1"/>
  <Setter Property="Background" Value="{StaticResource Brush.Border.Default}"/>
  <Setter Property="Margin" Value="3,6"/>
 </Style>
 <Style TargetType="Window">
  <Setter Property="Background" Value="{StaticResource Brush.Background.App}"/>
  <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
  <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
  <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
 </Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource Brush.Background.Elevated}"/><Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/></Style>
 <Style x:Key="Panel" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Brush.Background.Surface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.SM}"/>
  <Setter Property="Padding" Value="{StaticResource Layout.PanelPadding}"/>
 </Style>
 <Style x:Key="SectionLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
  <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
  <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
  <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
  <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,4,4"/>
  <Setter Property="MinWidth" Value="30"/><Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
 </Style>
 <Style x:Key="Button.Apply" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
  <Setter Property="Height" Value="32"/>
  <Setter Property="MinWidth" Value="72"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="StatusMessage.Attention" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
  <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="StatusMessage.Success" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
  <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
  <Setter Property="Margin" Value="0,0,12,0"/>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="TextEditor" TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
  <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="34"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="Inspection.CheckText" TargetType="TextBlock">
  <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="Margin" Value="0,2,12,2"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding Passed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
   <DataTrigger Binding="{Binding Passed}" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <DataTemplate x:Key="Inspection.Check"><TextBlock Text="{Binding Text}" Style="{StaticResource Inspection.CheckText}"/></DataTemplate>
 <Style x:Key="VerdictLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{StaticResource FontSize.Heading2}"/><Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
 <Style.Triggers>
   <Trigger Property="Text" Value="OK"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/><Setter Property="FontSize" Value="40"/></Trigger>
   <Trigger Property="Text" Value="NG"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/><Setter Property="FontSize" Value="40"/></Trigger>
   <Trigger Property="Text" Value="ERROR"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/><Setter Property="FontSize" Value="32"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Acquisition.ToggleButton" TargetType="Button">
  <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="154"/><Setter Property="Padding" Value="10,0"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/>
  <Setter Property="Background" Value="{StaticResource Brush.Background.Selected}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Tag" Value="{StaticResource Icon.Video}"/>
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.SM}" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path x:Name="Icon" Data="{TemplateBinding Tag}" Width="16" Height="16" Stretch="Uniform"
            Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                 FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding Acquiring}" Value="True">
      <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Status.Error}"/>
      <Setter TargetName="Root" Property="BorderThickness" Value="1.5"/>
      <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Brush.Status.Error}"/>
      <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
     </DataTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Background.Hover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Background.Surface}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
  <Style.Triggers>
   <DataTrigger Binding="{Binding Acquiring}" Value="True">
    <Setter Property="Width" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Tag" Value="{StaticResource Icon.Stop}"/><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Error}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="RunStatusLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/>
  <Style.Triggers>
   <Trigger Property="Text" Value="CHƯA CHẠY"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/><Setter Property="FontSize" Value="20"/></Trigger>
   <Trigger Property="Text" Value="ĐÃ DỪNG"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/><Setter Property="FontSize" Value="20"/></Trigger>
   <Trigger Property="Text" Value="OK"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/><Setter Property="FontSize" Value="40"/></Trigger>
   <Trigger Property="Text" Value="NG"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/><Setter Property="FontSize" Value="40"/></Trigger>
   <Trigger Property="Text" Value="ERROR"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/><Setter Property="FontSize" Value="40"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="ModeButton" TargetType="controls:ChevronButton">
  <Setter Property="Background" Value="{StaticResource Brush.Taskbar.Normal}"/><Setter Property="BorderBrush" Value="#70757C"/>
  <Setter Property="Foreground" Value="#111318"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Width" Value="208"/><Setter Property="Height" Value="64"/><Setter Property="Margin" Value="0,0,-30,0"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:ChevronButton">
   <Grid>
    <Path x:Name="shape" Data="M1,1 H165 L207,32 L165,63 H1 L43,32 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,30,0">
     <Path Width="18" Height="18" Data="{Binding CommandParameter,RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="9,0,0,0" FontWeight="Bold" FontSize="15"/>
    </StackPanel>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="TailMode" Value="Straight"><Setter TargetName="shape" Property="Data" Value="M1,1 H165 L207,32 L165,63 H1 Z"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shape" Property="Stroke" Value="{StaticResource Brush.Brand.Secondary}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="shape" Property="Opacity" Value="0.8"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="OcrPreview">
  <Border Background="{StaticResource Brush.Background.App}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" Padding="8" Margin="0,0,8,4" Width="190">
   <StackPanel>
    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
    <Image Source="{Binding Image}" Height="54" Stretch="Uniform" Margin="0,4"/>
    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Font.Monospace}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
 </DataTemplate>
</ResourceDictionary>
