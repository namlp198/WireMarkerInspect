<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing scale (multiples of 4) — docs/design/DESIGN_SYSTEM.md §5, §6. -->

    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.SM">8</sys:Double>
    <sys:Double x:Key="Spacing.MD">12</sys:Double>
    <sys:Double x:Key="Spacing.LG">16</sys:Double>
    <sys:Double x:Key="Spacing.XL">24</sys:Double>
    <sys:Double x:Key="Spacing.XXL">32</sys:Double>
    <Thickness x:Key="Spacing.Fence.Section">0,16,0,8</Thickness>
    <Thickness x:Key="Spacing.Fence.Field">0,4,8,4</Thickness>
    <Thickness x:Key="Spacing.Fence.Padding">8</Thickness>
    <Thickness x:Key="Layout.Fence.AlertMargin">0,0,0,104</Thickness>
    <sys:Double x:Key="Layout.Fence.AlertWidth">480</sys:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="Radius.SM">4</CornerRadius>
    <CornerRadius x:Key="Radius.MD">8</CornerRadius>
    <CornerRadius x:Key="Radius.LG">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

</ResourceDictionary>
