<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography tokens — docs/design/DESIGN_SYSTEM.md §4. -->

    <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Monospace">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Heading1">24</sys:Double>
    <sys:Double x:Key="FontSize.Heading2">20</sys:Double>
    <sys:Double x:Key="FontSize.Heading3">16</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.BodySmall">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Micro">11</sys:Double>

</ResourceDictionary>
