        <ResourceDictionary Source="pack://application:,,,/WireMarkerInspection.Desktop;component/Themes/Tokens/Elevation.xaml" />
        <ResourceDictionary Source="pack://application:,,,/WireMarkerInspection.Desktop;component/Themes/Tokens/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
