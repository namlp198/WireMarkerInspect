<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Color tokens — dark theme.
        Values mirror docs/design/DESIGN_SYSTEM.md §3. Brushes derive from colors.
        WPF hex is #AARRGGBB; opaque tokens are plain #RRGGBB.
    -->

    <!-- Neutral -->
    <Color x:Key="Color.Background.App">#0B1220</Color>
    <Color x:Key="Color.Background.Surface">#111A2B</Color>
    <Color x:Key="Color.Background.Elevated">#172236</Color>
    <Color x:Key="Color.Background.Hover">#1C2A42</Color>
    <Color x:Key="Color.Background.Selected">#203A5E</Color>
    <Color x:Key="Color.Border.Default">#29364C</Color>
    <Color x:Key="Color.Border.Strong">#3B4A63</Color>
    <Color x:Key="Color.Text.Primary">#F3F6FA</Color>
    <Color x:Key="Color.Text.Secondary">#AAB5C5</Color>
    <Color x:Key="Color.Text.Muted">#718096</Color>
    <Color x:Key="Color.Text.Disabled">#566276</Color>

    <!-- Brand -->
    <Color x:Key="Color.Brand.Primary">#2F80ED</Color>
    <Color x:Key="Color.Brand.PrimaryHover">#4A92F0</Color>
    <Color x:Key="Color.Brand.PrimaryPressed">#1F6FD0</Color>
    <Color x:Key="Color.Brand.Secondary">#00A6A6</Color>

    <!-- Mission planning (route line + waypoint markers) -->
    <Color x:Key="Color.Mission.Route">#FFE00A</Color>
    <Color x:Key="Color.Mission.Waypoint">#39D84A</Color>
    <Color x:Key="Color.Mission.Home">#FFB020</Color>
    <Color x:Key="Color.Mission.Transit">#36C5F0</Color>
    <Color x:Key="Color.Mission.Trajectory">#FF4FA3</Color>
    <Color x:Key="Color.Fleet.Trajectory1">#4A90E2</Color>
    <Color x:Key="Color.Fleet.Trajectory2">#E25D5D</Color>
    <Color x:Key="Color.Fleet.Trajectory3">#34C3A0</Color>
    <Color x:Key="Color.Fleet.Trajectory4">#C77DFF</Color>
    <Color x:Key="Color.Fleet.Trajectory5">#FF9F43</Color>
    <Color x:Key="Color.Fleet.Trajectory6">#2EC4E6</Color>
    <Color x:Key="Color.Fleet.Trajectory7">#F05FB8</Color>
    <Color x:Key="Color.Fleet.Trajectory8">#9BC53D</Color>
    <Color x:Key="Color.Fleet.Trajectory9">#FFD166</Color>
    <Color x:Key="Color.Fleet.Trajectory10">#7E8CE0</Color>

    <!-- Geo Measure feature palette -->
    <Color x:Key="Color.GeoMeasure.Polygon">#E466A8</Color>
    <Color x:Key="Color.GeoMeasure.Line">#7CEB3A</Color>
    <Color x:Key="Color.GeoMeasure.Rectangle">#C48BE0</Color>
    <Color x:Key="Color.GeoMeasure.Circle">#E6D95A</Color>
    <Color x:Key="Color.GeoMeasure.Marker">#5AA9E6</Color>

    <!-- Status -->
    <Color x:Key="Color.Status.Success">#2DBE78</Color>
    <Color x:Key="Color.Status.Warning">#F2B84B</Color>
    <Color x:Key="Color.Status.Error">#E45858</Color>
    <Color x:Key="Color.Status.Info">#4C9AFF</Color>
    <Color x:Key="Color.Status.Neutral">#7F8A9A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Background.App" Color="{StaticResource Color.Background.App}" />
    <SolidColorBrush x:Key="Brush.Background.Surface" Color="{StaticResource Color.Background.Surface}" />
    <SolidColorBrush x:Key="Brush.Background.Elevated" Color="{StaticResource Color.Background.Elevated}" />
    <SolidColorBrush x:Key="Brush.Background.Hover" Color="{StaticResource Color.Background.Hover}" />
    <SolidColorBrush x:Key="Brush.Background.Selected" Color="{StaticResource Color.Background.Selected}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />

    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="{StaticResource Color.Brand.Primary}" />
    <SolidColorBrush x:Key="Brush.Brand.PrimaryHover" Color="{StaticResource Color.Brand.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.Brand.PrimaryPressed" Color="{StaticResource Color.Brand.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.Brand.Secondary" Color="{StaticResource Color.Brand.Secondary}" />

    <SolidColorBrush x:Key="Brush.Mission.Route" Color="{StaticResource Color.Mission.Route}" />
    <SolidColorBrush x:Key="Brush.Mission.Waypoint" Color="{StaticResource Color.Mission.Waypoint}" />
    <SolidColorBrush x:Key="Brush.Mission.Home" Color="{StaticResource Color.Mission.Home}" />
    <SolidColorBrush x:Key="Brush.Mission.Transit" Color="{StaticResource Color.Mission.Transit}" />
    <SolidColorBrush x:Key="Brush.Mission.Trajectory" Color="{StaticResource Color.Mission.Trajectory}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory1" Color="{StaticResource Color.Fleet.Trajectory1}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory2" Color="{StaticResource Color.Fleet.Trajectory2}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory3" Color="{StaticResource Color.Fleet.Trajectory3}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory4" Color="{StaticResource Color.Fleet.Trajectory4}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory5" Color="{StaticResource Color.Fleet.Trajectory5}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory6" Color="{StaticResource Color.Fleet.Trajectory6}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory7" Color="{StaticResource Color.Fleet.Trajectory7}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory8" Color="{StaticResource Color.Fleet.Trajectory8}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory9" Color="{StaticResource Color.Fleet.Trajectory9}" />
    <SolidColorBrush x:Key="Brush.Fleet.Trajectory10" Color="{StaticResource Color.Fleet.Trajectory10}" />
    <SolidColorBrush x:Key="Brush.GeoMeasure.Polygon" Color="{StaticResource Color.GeoMeasure.Polygon}" />
    <SolidColorBrush x:Key="Brush.GeoMeasure.Line" Color="{StaticResource Color.GeoMeasure.Line}" />
    <SolidColorBrush x:Key="Brush.GeoMeasure.Rectangle" Color="{StaticResource Color.GeoMeasure.Rectangle}" />
    <SolidColorBrush x:Key="Brush.GeoMeasure.Circle" Color="{StaticResource Color.GeoMeasure.Circle}" />
    <SolidColorBrush x:Key="Brush.GeoMeasure.Marker" Color="{StaticResource Color.GeoMeasure.Marker}" />

    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}" />
    <SolidColorBrush x:Key="Brush.Status.Neutral" Color="{StaticResource Color.Status.Neutral}" />

</ResourceDictionary>
