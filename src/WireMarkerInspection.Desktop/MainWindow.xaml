<Window x:Class="WireMarkerInspection.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:WireMarkerInspection.Desktop.Views"
 xmlns:controls="clr-namespace:WireMarkerInspection.Controls;assembly=WireMarkerInspection.Controls"
 Title="Wire Marker Inspection" Width="1600" Height="1000" MinWidth="1366" MinHeight="860" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Brush.Background.App}" Foreground="{StaticResource Brush.Text.Primary}" FontFamily="{StaticResource Font.Primary}">
 <Grid Margin="{StaticResource Layout.PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
    <TextBlock Text="WIRE MARKER INSPECTION" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Right"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
     <TextBlock Text="{Binding SourceStatus}" Foreground="{StaticResource Brush.Brand.Primary}" FontWeight="Bold" FontSize="12" Margin="0,0,14,0"/>
     <TextBlock Text="C++ CORE / .NET UI" Style="{StaticResource Caption}"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
    <controls:ChevronButton Content="SETTING" TailMode="Straight" Command="{Binding SettingCommand}" CommandParameter="{StaticResource Icon.Settings}" Panel.ZIndex="1">
     <controls:ChevronButton.Style><Style TargetType="controls:ChevronButton" BasedOn="{StaticResource ModeButton}">
      <Style.Triggers><DataTrigger Binding="{Binding RunPage}" Value="False"><Setter Property="Background" Value="{StaticResource Brush.Taskbar.Active}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Secondary}"/></DataTrigger></Style.Triggers>
     </Style></controls:ChevronButton.Style>
    </controls:ChevronButton>
    <controls:ChevronButton Content="RUN" TailMode="Notched" Command="{Binding StartRunCommand}" CommandParameter="{StaticResource Icon.Video}" Panel.ZIndex="2">
     <controls:ChevronButton.Style><Style TargetType="controls:ChevronButton" BasedOn="{StaticResource ModeButton}">
      <Style.Triggers><DataTrigger Binding="{Binding RunPage}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.Taskbar.Active}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Secondary}"/></DataTrigger></Style.Triggers>
     </Style></controls:ChevronButton.Style>
    </controls:ChevronButton>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" Background="{StaticResource Brush.Background.Surface}" Padding="12,8" Margin="0,0,0,12">
   <DockPanel>
    <Button DockPanel.Dock="Right" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Sync}" ToolTip="Kiểm tra OCR assets" AutomationProperties.Name="Kiểm tra OCR assets" Command="{Binding RefreshOcrCommand}" Margin="12,0,0,0"/>
    <TextBlock Text="{Binding OcrStatus}" Foreground="{StaticResource Brush.Status.Warning}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding RunPage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="ACQUISITION" Style="{StaticResource SectionLabel}"/>
      <TextBlock Text="Nguồn ảnh" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <controls:ImageHud x:Name="LiveCameraHud" Caption="LIVE CAMERA · READ ONLY" Height="230" Margin="-6,0,-6,8" CanExpand="True" ExpandRequested="ExpandLiveCamera">
       <controls:ImageHud.Viewer><controls:ImageViewer Source="{Binding LiveImage}"/></controls:ImageHud.Viewer>
      </controls:ImageHud>
      <Border Style="{StaticResource Hud.Container}" HorizontalAlignment="Left" Padding="4" Margin="0,0,0,12"><StackPanel Orientation="Horizontal">
       <Button x:Name="AcquisitionButton" Style="{StaticResource Acquisition.ToggleButton}" Content="{Binding AcquisitionActionLabel}" ToolTip="{Binding AcquisitionActionLabel}" AutomationProperties.Name="{Binding AcquisitionActionLabel}" Command="{Binding AcquisitionCommand}" IsEnabled="{Binding CanToggleAcquisition}" Margin="0,0,4,0"/>
       <Button x:Name="ScanCameraButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Search}" ToolTip="Tìm camera" AutomationProperties.Name="Tìm camera" Command="{Binding ScanCamerasCommand}" IsEnabled="{Binding CanSearchCamera}"/>
       <Button x:Name="ConnectCameraButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Connect}" ToolTip="Kết nối camera" AutomationProperties.Name="Kết nối camera" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnectCamera}"/>
       <Button x:Name="DisconnectCameraButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Disconnect}" ToolTip="Ngắt kết nối camera" AutomationProperties.Name="Ngắt kết nối camera" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnectCamera}"/>
      </StackPanel></Border>
      <TextBlock Text="HIKROBOT MVS" Style="{StaticResource SectionLabel}"/>
      <ComboBox x:Name="CameraSelector" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectCamera}" Style="{StaticResource Input.Combo}" Margin="0,0,0,8"/>
      <Border x:Name="FindingIndicator" Background="{StaticResource Brush.Background.Selected}" BorderBrush="{StaticResource Brush.Status.Warning}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8,6" Margin="0,4,0,8" Visibility="{Binding FindingCamera,Converter={StaticResource BoolToVisibility}}">
       <StackPanel><TextBlock Text="◌  FINDING CAMERA..." Foreground="{StaticResource Brush.Status.Warning}" FontWeight="Bold"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Foreground="{StaticResource Brush.Status.Warning}"/></StackPanel>
      </Border>
      <TextBlock x:Name="CameraStatusText" Text="{Binding CameraStatus}" Margin="0,8,0,20" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding CameraState}" Value="Finding"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Found"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Connected"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Acquiring"><Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/><Setter Property="FontSize" Value="13"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Reconnecting"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/><Setter Property="FontSize" Value="13"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="NotFound"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Error"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger>
        </Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="AcquisitionSummaryText" Text="{Binding AcquisitionSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,0,0,20"/>
      <DockPanel Margin="0,0,0,4">
       <Button x:Name="ReadCameraSettingsButton" DockPanel.Dock="Right" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Sync}" ToolTip="Đọc thông số hiện tại từ camera" AutomationProperties.Name="Đọc thông số từ camera" Command="{Binding ReadCameraSettingsCommand}" IsEnabled="{Binding CanEditCameraParameters}"/>
       <TextBlock Text="CAMERA PARAMETERS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="CameraInfoText" Text="{Binding CameraInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="Thông số được lưu theo từng model recipe." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <DockPanel Margin="0,4,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding ExposureRange}" Style="{StaticResource Caption}"/><TextBlock Text="Exposure (µs)" Style="{StaticResource Caption}"/></DockPanel>
      <TextBox x:Name="ExposureTextBox" Text="{Binding Exposure,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCameraParameters}" Style="{StaticResource TextEditor}"/>
      <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding GainRange}" Style="{StaticResource Caption}"/><TextBlock Text="Gain (dB)" Style="{StaticResource Caption}"/></DockPanel>
      <TextBox x:Name="GainTextBox" Text="{Binding Gain,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCameraParameters}" Style="{StaticResource TextEditor}"/>
      <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding GammaRange}" Style="{StaticResource Caption}"/><CheckBox x:Name="GammaCheckBox" Content="Gamma" IsChecked="{Binding GammaEnabled}" IsEnabled="{Binding CanEditGamma}" Margin="0"/></DockPanel>
      <TextBox x:Name="GammaTextBox" Text="{Binding Gamma,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding GammaEnabled}" Style="{StaticResource TextEditor}"/>
      <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding BlackLevelRange}" Style="{StaticResource Caption}"/><CheckBox x:Name="BlackLevelCheckBox" Content="Black level" IsChecked="{Binding BlackLevelEnabled}" IsEnabled="{Binding CanEditBlackLevel}" Margin="0"/></DockPanel>
      <TextBox x:Name="BlackLevelTextBox" Text="{Binding BlackLevel,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding BlackLevelEnabled}" Style="{StaticResource TextEditor}"/>
      <CheckBox x:Name="AdvancedCameraCheckBox" Content="Thông số nâng cao" IsChecked="{Binding ShowAdvancedCamera}" Margin="0,14,0,0"/>
      <StackPanel x:Name="AdvancedCameraPanel" Visibility="{Binding ShowAdvancedCamera,Converter={StaticResource BoolToVisibility}}">
       <DockPanel Margin="0,10,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding SensorRange}" Style="{StaticResource Caption}"/><CheckBox x:Name="SensorRoiCheckBox" Content="Vùng đọc sensor" IsChecked="{Binding SensorRoiEnabled}" IsEnabled="{Binding CanEditSensorRoi}" Margin="0"/></DockPanel>
       <Grid IsEnabled="{Binding SensorRoiEnabled}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Offset X" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Offset Y" Style="{StaticResource Caption}"/>
        <TextBox Grid.Row="1" x:Name="SensorOffsetXTextBox" Text="{Binding SensorOffsetX,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SensorOffsetY,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBlock Grid.Row="2" Text="Width" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Height" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <TextBox Grid.Row="3" x:Name="SensorWidthTextBox" Text="{Binding SensorWidth,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SensorHeight,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       </Grid>
       <CheckBox x:Name="StrobeCheckBox" Content="Đèn strobe theo phơi sáng" IsChecked="{Binding StrobeEnabled}" IsEnabled="{Binding CanEditStrobe}" Margin="0,14,0,0"/>
       <Grid IsEnabled="{Binding StrobeEnabled}" Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Line" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Duration (µs)" Style="{StaticResource Caption}"/><TextBlock Grid.Column="4" Text="Delay (µs)" Style="{StaticResource Caption}"/>
        <TextBox Grid.Row="1" x:Name="StrobeLineTextBox" Text="{Binding StrobeLine,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding StrobeDuration,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding StrobeDelay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       </Grid>
       <TextBlock Text="LineMode của chân strobe phải đặt sẵn trong MVS." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
      <Button x:Name="ApplyCameraParametersButton" Content="Apply" Style="{StaticResource Button.Apply}" ToolTip="Áp dụng thông số camera" AutomationProperties.Name="Áp dụng thông số camera" Command="{Binding CameraParametersCommand}" IsEnabled="{Binding CanEditCameraParameters}" Margin="0,12,0,8"/>
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,0,0,20"/>
      <TextBlock Text="INSPECTION MODULES" Style="{StaticResource SectionLabel}"/>
      <CheckBox Content="OCR text" IsChecked="True" IsEnabled="False" Margin="0,0,0,10"/>
      <CheckBox Content="Wire color" IsEnabled="False" Margin="0,0,0,10"/>
      <CheckBox Content="Terminal template" IsEnabled="False"/>
      <TextBlock Text="Color / Template: chưa triển khai." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}" Padding="8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Code" Style="{StaticResource Input.Combo}" ToolTip="Chọn model" Margin="0,0,6,0"/>
      <Button Grid.Column="1" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Plus}" ToolTip="Add Model" AutomationProperties.Name="Add Model" Click="AddModel"/>
      <Button x:Name="EditModelButton" Grid.Column="2" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Edit}" ToolTip="Edit Model" AutomationProperties.Name="Edit Model" Click="EditModel" IsEnabled="{Binding CanManageSelectedModel}"/>
      <Button x:Name="DeleteModelButton" Grid.Column="3" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Delete}" ToolTip="Delete Model" AutomationProperties.Name="Delete Model" Command="{Binding DeleteModelCommand}" IsEnabled="{Binding CanManageSelectedModel}"/>
     </Grid>
    </Border>
    <Grid x:Name="ModelSetupEditors" Grid.Row="2" IsEnabled="{Binding CanConfigureModel}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <views:EndEditorView x:Name="FirstEndEditor" DataContext="{Binding End1}" Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"/>
     <views:EndEditorView x:Name="SecondEndEditor" Grid.Column="2" DataContext="{Binding End2}" Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
   </Grid>
   <Border Grid.Column="4" Style="{StaticResource Panel}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding ModelCount}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBlock x:Name="UnsavedNotification" Text="● CẦN LƯU" Foreground="{StaticResource Brush.Status.Error}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8" Visibility="{Binding Dirty,Converter={StaticResource BoolToVisibility}}"/><Button x:Name="SaveRecipeButton" Tag="{StaticResource Icon.Save}" ToolTip="Save Recipe" AutomationProperties.Name="Save Recipe" Command="{Binding SaveRecipeCommand}" IsEnabled="{Binding CanSaveRecipe}" Margin="0,0,0,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolRail.Button}"><Style.Triggers><DataTrigger Binding="{Binding Dirty}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Brand.Secondary}"/><Setter Property="Background" Value="{StaticResource Brush.Background.Selected}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><TextBlock Text="MODEL LIBRARY" Style="{StaticResource SectionLabel}"/></DockPanel>
      <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" ToolTip="Tìm mã hoặc tên model" Margin="0,4,0,12"/>
     </StackPanel>
     <DataGrid x:Name="ModelLibraryGrid" ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}" IsReadOnly="True" AutoGenerateColumns="False"
      EnableRowVirtualization="True" RowHeight="116" IsEnabled="{Binding CanEdit}">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="MODEL" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Code}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Revision}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="OCR · ĐẦU 1" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><Image Source="{Binding First}" Stretch="Uniform" Height="58"/><TextBlock Text="{Binding FirstExpected}" FontFamily="{StaticResource Font.Monospace}" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding FirstExpected}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="OCR · ĐẦU 2" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><Image Source="{Binding Second}" Stretch="Uniform" Height="58"/><TextBlock Text="{Binding SecondExpected}" FontFamily="{StaticResource Font.Monospace}" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding SecondExpected}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Visibility="{Binding RunPage,Converter={StaticResource BoolToVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
    <DockPanel>
     <Border DockPanel.Dock="Right" Style="{StaticResource Hud.Container}" Padding="4"><StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.OpenImage}" ToolTip="Load ảnh offline" AutomationProperties.Name="Load runtime image" Command="{Binding LoadRuntimeCommand}" IsEnabled="{Binding CanCapture}"/>
      <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Camera}" ToolTip="{Binding CaptureLabel}" AutomationProperties.Name="Capture runtime image" Command="{Binding CaptureRuntimeCommand}" IsEnabled="{Binding CanCapture}"/>
      <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.ArrowRight}" ToolTip="Sản phẩm tiếp" AutomationProperties.Name="Sản phẩm tiếp" Command="{Binding NextProductCommand}" IsEnabled="{Binding CanNext}"/>
      <Button x:Name="StopRuntimeButton" Style="{StaticResource ToolRail.DangerButton}" Tag="{StaticResource Icon.Stop}" ToolTip="Stop" AutomationProperties.Name="Stop runtime" Command="{Binding StopRunCommand}" IsEnabled="{Binding Running}"/>
     </StackPanel></Border>
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="RunStatusText" Text="{Binding RunStatus}" Style="{StaticResource RunStatusLabel}" VerticalAlignment="Center" Margin="0,0,24,0"/>
      <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="{Binding ActiveModel}" FontWeight="Bold"/><TextBlock Text="{Binding CycleLabel}" Style="{StaticResource Caption}"/></StackPanel>
      <StackPanel VerticalAlignment="Center">
       <TextBlock x:Name="CycleTimingText" Text="{Binding CycleTimingText}" Style="{StaticResource Caption}"/>
       <TextBlock x:Name="RunAcquisitionSummaryText" Text="{Binding AcquisitionSummary}" Style="{StaticResource Caption}"/>
      </StackPanel>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <views:EndResultView x:Name="FirstEndResult" DataContext="{Binding Result1}"/>
    <views:EndResultView x:Name="SecondEndResult" Grid.Column="2" DataContext="{Binding Result2}"/>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Padding="4,10,4,0">
   <DockPanel>
    <TextBlock Text="{Binding Message}" Style="{StaticResource StatusMessage.Attention}" MaxHeight="52"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
