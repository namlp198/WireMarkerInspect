<Window x:Class="WireMarkerInspection.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:WireMarkerInspection.Desktop.Views"
 xmlns:controls="clr-namespace:WireMarkerInspection.Controls;assembly=WireMarkerInspection.Controls"
 xmlns:loc="clr-namespace:WireMarkerInspection.Controls.Localization;assembly=WireMarkerInspection.Controls"
 Title="{loc:Text AppTitle}" Width="1600" Height="1000" MinWidth="1366" MinHeight="860" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Brush.Background.App}" Foreground="{StaticResource Brush.Text.Primary}" FontFamily="{StaticResource Font.Primary}">
 <Window.Resources>
  <DataTemplate x:Key="LanguageTemplate">
   <Grid Width="30" Height="30">
    <Grid x:Name="ViFlag" Visibility="Collapsed">
     <Ellipse Fill="#DA251D"/>
     <Path Width="17" Height="17" Fill="#FFFF00" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M50,5 L60.6,37.3 L94.5,37.3 L67,57.3 L77.5,89.5 L50,69.6 L22.5,89.5 L33,57.3 L5.5,37.3 L39.4,37.3 Z"/>
    </Grid>
    <Grid x:Name="EnFlag" Visibility="Collapsed">
     <Grid.Clip><EllipseGeometry Center="15,15" RadiusX="14" RadiusY="14"/></Grid.Clip>
     <Ellipse Fill="#012169"/>
     <Path Data="M0,0 L30,30 M30,0 L0,30" Stroke="White" StrokeThickness="7"/>
     <Path Data="M0,0 L30,30 M30,0 L0,30" Stroke="#C8102E" StrokeThickness="3"/>
     <Rectangle Width="30" Height="9" Fill="White"/><Rectangle Width="9" Height="30" Fill="White"/>
     <Rectangle Width="30" Height="4" Fill="#C8102E"/><Rectangle Width="4" Height="30" Fill="#C8102E"/>
    </Grid>
    <Grid x:Name="KoFlag" Visibility="Collapsed">
     <Ellipse Fill="White" Stroke="#CBD5E1" StrokeThickness="1"/>
     <Path Data="M8,15 A7,7 0 0 1 22,15 L8,15 Z" Fill="#CD2E3A"/>
     <Path Data="M8,15 A7,7 0 0 0 22,15 L8,15 Z" Fill="#0047A0"/>
     <Rectangle Width="7" Height="1.4" Fill="#111827" Margin="4,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-35"/></Rectangle.RenderTransform></Rectangle>
     <Rectangle Width="7" Height="1.4" Fill="#111827" Margin="0,0,4,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-35"/></Rectangle.RenderTransform></Rectangle>
    </Grid>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding}" Value="{x:Static loc:AppLanguage.Vietnamese}"><Setter TargetName="ViFlag" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="{x:Static loc:AppLanguage.English}"><Setter TargetName="EnFlag" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="{x:Static loc:AppLanguage.Korean}"><Setter TargetName="KoFlag" Property="Visibility" Value="Visible"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="LanguageComboBox" TargetType="ComboBox">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
     <ContentPresenter Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Ellipse Fill="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
      <Border Margin="0,5,0,0" Padding="4" Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="18"><StackPanel IsItemsHost="True"/></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LanguageComboBoxItem" TargetType="ComboBoxItem">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemRoot" Background="Transparent" CornerRadius="19"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.Background.Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="{StaticResource Layout.PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <TextBlock Text="{loc:Text AppTitle}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
     <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding CurrentLanguage,Mode=TwoWay}" ItemTemplate="{StaticResource LanguageTemplate}" ItemContainerStyle="{StaticResource LanguageComboBoxItem}" Style="{StaticResource LanguageComboBox}" Margin="10,0,0,0" ToolTip="{loc:Text LanguageSelection}" AutomationProperties.Name="{loc:Text LanguageSelection}"/>
    </StackPanel>
     <TextBlock x:Name="HeaderConnectionStatus" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Text Offline}"/><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/><Style.Triggers><DataTrigger Binding="{Binding IsCameraOnline}" Value="True"><Setter Property="Text" Value="{loc:Text Online}"/><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
    <controls:ChevronButton Content="{loc:Text Settings}" TailMode="Straight" Command="{Binding SettingCommand}" CommandParameter="{StaticResource Icon.Settings}" Panel.ZIndex="1">
     <controls:ChevronButton.Style><Style TargetType="controls:ChevronButton" BasedOn="{StaticResource ModeButton}">
      <Style.Triggers><DataTrigger Binding="{Binding RunPage}" Value="False"><Setter Property="Background" Value="{StaticResource Brush.Taskbar.Active}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Secondary}"/></DataTrigger></Style.Triggers>
     </Style></controls:ChevronButton.Style>
    </controls:ChevronButton>
    <controls:ChevronButton Content="{loc:Text Run}" TailMode="Notched" Command="{Binding StartRunCommand}" CommandParameter="{StaticResource Icon.Video}" Panel.ZIndex="2">
     <controls:ChevronButton.Style><Style TargetType="controls:ChevronButton" BasedOn="{StaticResource ModeButton}">
      <Style.Triggers><DataTrigger Binding="{Binding RunPage}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.Taskbar.Active}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Secondary}"/></DataTrigger></Style.Triggers>
     </Style></controls:ChevronButton.Style>
    </controls:ChevronButton>
   </StackPanel>
  </DockPanel>
  <Border x:Name="OcrStatusPanel" Grid.Row="1" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" Background="{StaticResource Brush.Background.Surface}" Padding="12,8" Margin="0,0,0,12" IsEnabled="{Binding IsAdmin}">
   <DockPanel>
    <Button DockPanel.Dock="Right" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Sync}" ToolTip="{loc:Text CheckOcrAssets}" AutomationProperties.Name="{loc:Text CheckOcrAssets}" Command="{Binding RefreshOcrCommand}" Margin="12,0,0,0"/>
    <TextBlock Text="{Binding OcrStatus}" Foreground="{StaticResource Brush.Status.Warning}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding RunPage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="AccessPanel" Grid.Row="0" Style="{StaticResource Panel}">
     <StackPanel>
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Border Background="{StaticResource Brush.Background.Selected}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8,4" Margin="0,0,6,0"><TextBlock Text="{Binding AccessRoleLabel}" FontWeight="Bold" Foreground="{StaticResource Brush.Brand.Secondary}"/></Border>
        <Button x:Name="LoginButton" Content="{loc:Text Login}" ToolTip="{loc:Text LoginTooltip}" Click="Login"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button x:Name="LogoutButton" Content="{loc:Text Logout}" Command="{Binding LogoutCommand}" ToolTip="{loc:Text LogoutTooltip}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       </StackPanel>
       <TextBlock Text="{loc:Text Access}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding AccessSummary}" Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Brand.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border x:Name="AcquisitionPanel" Grid.Row="2" Style="{StaticResource Panel}">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="{loc:Text Acquisition}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
      <TextBlock Text="{loc:Text ImageSource}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <controls:ImageHud x:Name="LiveCameraHud" Caption="{loc:Text LiveCameraReadOnly}" Height="230" Margin="-6,0,-6,8" CanExpand="True" ExpandRequested="ExpandLiveCamera">
       <controls:ImageHud.Viewer><controls:ImageViewer Source="{Binding LiveImage}"/></controls:ImageHud.Viewer>
      </controls:ImageHud>
      <Border Style="{StaticResource Hud.Container}" HorizontalAlignment="Left" Padding="4" Margin="0,0,0,12"><StackPanel Orientation="Horizontal">
       <Button x:Name="AcquisitionButton" Style="{StaticResource Acquisition.ToggleButton}" Content="{Binding AcquisitionActionLabel}" ToolTip="{Binding AcquisitionActionLabel}" AutomationProperties.Name="{Binding AcquisitionActionLabel}" Command="{Binding AcquisitionCommand}" IsEnabled="{Binding CanToggleAcquisition}" Margin="0,0,4,0"/>
       <Button x:Name="ScanCameraButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Search}" ToolTip="{loc:Text SearchCamera}" AutomationProperties.Name="{loc:Text SearchCamera}" Command="{Binding ScanCamerasCommand}" IsEnabled="{Binding CanSearchCamera}"/>
       <Button x:Name="ConnectCameraButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Connect}" ToolTip="{loc:Text ConnectCamera}" AutomationProperties.Name="{loc:Text ConnectCamera}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnectCamera}"/>
       <Button x:Name="DisconnectCameraButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Disconnect}" ToolTip="{loc:Text DisconnectCamera}" AutomationProperties.Name="{loc:Text DisconnectCamera}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnectCamera}"/>
      </StackPanel></Border>
      <TextBlock Text="HIKROBOT MVS" Style="{StaticResource SectionLabel}"/>
      <ComboBox x:Name="CameraSelector" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectCamera}" Style="{StaticResource Input.Combo}" Margin="0,0,0,8"/>
      <Border x:Name="FindingIndicator" Background="{StaticResource Brush.Background.Selected}" BorderBrush="{StaticResource Brush.Status.Warning}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8,6" Margin="0,4,0,8" Visibility="{Binding FindingCamera,Converter={StaticResource BoolToVisibility}}">
       <StackPanel><TextBlock Text="{loc:Text FindingCamera}" Foreground="{StaticResource Brush.Status.Warning}" FontWeight="Bold"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Foreground="{StaticResource Brush.Status.Warning}"/></StackPanel>
      </Border>
      <TextBlock x:Name="CameraStatusText" Text="{Binding CameraStatus}" Margin="0,8,0,20" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding CameraState}" Value="Finding"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Found"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Connected"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Acquiring"><Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/><Setter Property="FontSize" Value="13"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Reconnecting"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/><Setter Property="FontSize" Value="13"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="NotFound"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger>
         <DataTrigger Binding="{Binding CameraState}" Value="Error"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger>
        </Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="AcquisitionSummaryText" Text="{Binding AcquisitionSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <StackPanel x:Name="AdminSettingsPanel" Visibility="{Binding IsAdmin,Converter={StaticResource BoolToVisibility}}">
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,0,0,20"/>
      <DockPanel Margin="0,0,0,4">
       <Button x:Name="ReadCameraSettingsButton" DockPanel.Dock="Right" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Sync}" ToolTip="{loc:Text ReadCameraSettings}" AutomationProperties.Name="{loc:Text ReadCameraSettings}" Command="{Binding ReadCameraSettingsCommand}" IsEnabled="{Binding CanEditCameraParameters}"/>
       <TextBlock Text="{loc:Text CameraParameters}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="CameraInfoText" Text="{Binding CameraInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{loc:Text CameraRecipeHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <DockPanel Margin="0,4,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding ExposureRange}" Style="{StaticResource Caption}"/><TextBlock Text="Exposure (µs)" Style="{StaticResource Caption}"/></DockPanel>
      <TextBox x:Name="ExposureTextBox" Text="{Binding Exposure,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCameraParameters}" Style="{StaticResource TextEditor}"/>
      <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding GainRange}" Style="{StaticResource Caption}"/><TextBlock Text="Gain (dB)" Style="{StaticResource Caption}"/></DockPanel>
      <TextBox x:Name="GainTextBox" Text="{Binding Gain,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCameraParameters}" Style="{StaticResource TextEditor}"/>
      <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding GammaRange}" Style="{StaticResource Caption}"/><CheckBox x:Name="GammaCheckBox" Content="Gamma" IsChecked="{Binding GammaEnabled}" IsEnabled="{Binding CanEditGamma}" Margin="0"/></DockPanel>
      <TextBox x:Name="GammaTextBox" Text="{Binding Gamma,UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource TextEditor}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanEditGamma}" Value="True"/><Condition Binding="{Binding GammaEnabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
      <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding BlackLevelRange}" Style="{StaticResource Caption}"/><CheckBox x:Name="BlackLevelCheckBox" Content="Black level" IsChecked="{Binding BlackLevelEnabled}" IsEnabled="{Binding CanEditBlackLevel}" Margin="0"/></DockPanel>
      <TextBox x:Name="BlackLevelTextBox" Text="{Binding BlackLevel,UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource TextEditor}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanEditBlackLevel}" Value="True"/><Condition Binding="{Binding BlackLevelEnabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
      <CheckBox x:Name="AdvancedCameraCheckBox" Content="{loc:Text AdvancedParameters}" IsChecked="{Binding ShowAdvancedCamera}" IsEnabled="{Binding IsAdmin}" Margin="0,14,0,0"/>
      <StackPanel x:Name="AdvancedCameraPanel" Visibility="{Binding ShowAdvancedCamera,Converter={StaticResource BoolToVisibility}}">
       <DockPanel Margin="0,10,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding SensorRange}" Style="{StaticResource Caption}"/><CheckBox x:Name="SensorRoiCheckBox" Content="{loc:Text SensorRegion}" IsChecked="{Binding SensorRoiEnabled}" IsEnabled="{Binding CanEditSensorRoi}" Margin="0"/></DockPanel>
       <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanEditSensorRoi}" Value="True"/><Condition Binding="{Binding SensorRoiEnabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Offset X" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Offset Y" Style="{StaticResource Caption}"/>
        <TextBox Grid.Row="1" x:Name="SensorOffsetXTextBox" Text="{Binding SensorOffsetX,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SensorOffsetY,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBlock Grid.Row="2" Text="Width" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Height" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <TextBox Grid.Row="3" x:Name="SensorWidthTextBox" Text="{Binding SensorWidth,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SensorHeight,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       </Grid>
       <CheckBox x:Name="StrobeCheckBox" Content="{loc:Text StrobeExposure}" IsChecked="{Binding StrobeEnabled}" IsEnabled="{Binding CanEditStrobe}" Margin="0,14,0,0"/>
       <Grid Margin="0,6,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanEditStrobe}" Value="True"/><Condition Binding="{Binding StrobeEnabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Line" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Duration (µs)" Style="{StaticResource Caption}"/><TextBlock Grid.Column="4" Text="Delay (µs)" Style="{StaticResource Caption}"/>
        <TextBox Grid.Row="1" x:Name="StrobeLineTextBox" Text="{Binding StrobeLine,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding StrobeDuration,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding StrobeDelay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       </Grid>
       <TextBlock Text="{loc:Text StrobeLineModeHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
      <Button x:Name="ApplyCameraParametersButton" Content="{loc:Text Apply}" Style="{StaticResource Button.Apply}" ToolTip="{loc:Text ApplyCamera}" AutomationProperties.Name="{loc:Text ApplyCamera}" Command="{Binding CameraParametersCommand}" IsEnabled="{Binding CanEditCameraParameters}" Margin="0,12,0,8"/>
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,0,0,20"/>
      <TextBlock Text="{loc:Text PlcConnection}" Style="{StaticResource SectionLabel}"/>
      <TextBlock Text="{loc:Text PlcConnectionHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <Grid Margin="0,4,0,0" IsEnabled="{Binding CanConfigurePlc}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{loc:Text PlcVendor}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{loc:Text PhysicalConnection}" Style="{StaticResource Caption}"/>
       <ComboBox Grid.Row="1" x:Name="PlcVendorSelector" ItemsSource="{Binding PlcVendors}" SelectedItem="{Binding PlcVendor}" Style="{StaticResource Input.Combo}" Height="28"/>
       <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PlcTransportSelector" ItemsSource="{Binding PlcTransports}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PlcTransport}" Style="{StaticResource Input.Combo}" Height="28"/>
      </Grid>
      <Grid x:Name="PlcEthernetPanel" Margin="0,10,0,0" IsEnabled="{Binding CanConfigurePlc}" Visibility="{Binding PlcUsesNetwork,Converter={StaticResource BoolToVisibility}}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{loc:Text IpAddress}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Port" Style="{StaticResource Caption}"/>
       <TextBox Grid.Row="1" x:Name="PlcHostTextBox" Text="{Binding PlcHost,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PlcPort,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
      </Grid>
      <Grid x:Name="PlcComPanel" Margin="0,10,0,0" IsEnabled="{Binding CanConfigurePlc}" Visibility="{Binding PlcUsesSerial,Converter={StaticResource BoolToVisibility}}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{loc:Text ComPort}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Baud rate" Style="{StaticResource Caption}"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="PlcSerialPortSelector" ItemsSource="{Binding PlcSerialPorts}" SelectedItem="{Binding PlcSerialPort}" Style="{StaticResource Input.Combo}" Height="28"/>
        <Button Grid.Column="1" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Sync}" ToolTip="{loc:Text RefreshComPorts}" AutomationProperties.Name="{loc:Text RefreshComPorts}" Command="{Binding RefreshPlcPortsCommand}" Margin="4,0,0,0"/>
       </Grid>
       <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PlcBaudRate,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       <TextBlock Grid.Row="2" Text="{loc:Text Protocol}" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Text DataBits}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
       <ComboBox Grid.Row="3" ItemsSource="{Binding PlcSerialProtocols}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PlcSerialProtocol}" Style="{StaticResource Input.Combo}" Height="28"/>
       <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding PlcDataBits,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       <TextBlock Grid.Row="4" Text="{loc:Text Parity}" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:Text StopBits}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
       <ComboBox Grid.Row="5" ItemsSource="{Binding PlcParities}" SelectedItem="{Binding PlcParity}" Style="{StaticResource Input.Combo}" Height="28"/>
       <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding PlcStopBitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PlcStopBits}" Style="{StaticResource Input.Combo}" Height="28"/>
      </Grid>
      <Grid Margin="0,10,0,0" IsEnabled="{Binding CanConfigurePlc}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{loc:Text UnitId}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{loc:Text TimeoutMs}" Style="{StaticResource Caption}"/>
       <TextBox Grid.Row="1" Text="{Binding PlcUnitId,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PlcTimeoutMs,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
      </Grid>
      <TextBlock x:Name="PlcStatusText" Text="{Binding PlcStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/><Style.Triggers>
        <DataTrigger Binding="{Binding PlcConnectionState}" Value="Connecting"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding PlcConnectionState}" Value="Connected"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding PlcConnectionState}" Value="Error"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
       <Button x:Name="ConnectPlcButton" Content="{loc:Text ConnectPlc}" Style="{StaticResource Button.Apply}" Command="{Binding ConnectPlcCommand}" IsEnabled="{Binding CanConnectPlc}"/>
       <Button x:Name="DisconnectPlcButton" Content="{loc:Text Disconnect}" Style="{StaticResource Button.Secondary}" Foreground="{StaticResource Brush.Status.Error}" BorderBrush="{StaticResource Brush.Status.Error}" Command="{Binding DisconnectPlcCommand}" IsEnabled="{Binding CanDisconnectPlc}" Margin="6,0,0,0"/>
       <Button x:Name="SaveMachineSettingsButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Save}" ToolTip="{loc:Text SavePlcConnection}" AutomationProperties.Name="{loc:Text SavePlcConnection}" Command="{Binding SaveMachineSettingsCommand}" IsEnabled="{Binding CanConfigurePlc}" Margin="6,0,0,0"/>
      </StackPanel>
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,20,0,20"/>
      <TextBlock Text="{loc:Text Trigger}" Style="{StaticResource SectionLabel}"/>
      <TextBlock Text="{loc:Text TriggerSourceHelp}" Style="{StaticResource Caption}" Margin="0,4"/>
      <ComboBox x:Name="TriggerKindSelector" ItemsSource="{Binding TriggerKindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TriggerKind}" IsEnabled="{Binding CanEditRecipeIo}" Style="{StaticResource Input.Combo}" Height="28"/>
      <TextBlock Text="{loc:Text SignalMapping}" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
      <ComboBox x:Name="TriggerMappingSelector" ItemsSource="{Binding TriggerMappingOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TriggerMapping}" IsEnabled="{Binding CanEditRecipeIo}" Style="{StaticResource Input.Combo}" Height="28"/>
      <TextBlock Text="{loc:Text MappingHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <Grid x:Name="CameraTriggerPanel" Margin="0,12,0,0">
       <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TriggerKind}" Value="CameraLine"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{loc:Text CameraLine}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{loc:Text DebouncerUs}" Style="{StaticResource Caption}"/>
       <TextBox Grid.Row="1" x:Name="TriggerLineTextBox" Text="{Binding TriggerLine,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRecipeIo}" Style="{StaticResource TextEditor}"/>
       <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding TriggerDebouncer,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRecipeIo}" Style="{StaticResource TextEditor}"/>
       <TextBlock Grid.Row="2" Text="{loc:Text DelayUs}" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Text RepeatBlockMs}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
       <TextBox Grid.Row="3" Text="{Binding TriggerDelay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRecipeIo}" Style="{StaticResource TextEditor}"/>
       <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding TriggerRepeatBlock,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRecipeIo}" Style="{StaticResource TextEditor}"/>
       <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="TriggerRisingEdgeCheckBox" Content="{loc:Text RisingEdge}" IsChecked="{Binding TriggerRisingEdge}" IsEnabled="{Binding CanEditRecipeIo}" Margin="0,10,0,0"/>
      </Grid>
      <StackPanel x:Name="PlcTriggerPanel" Margin="0,12,0,0" IsEnabled="{Binding CanEditRecipeIo}">
       <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TriggerKind}" Value="Plc"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="{loc:Text PlcPollMs}" Style="{StaticResource Caption}"/>
       <TextBox Text="{Binding PlcPollMs,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       <StackPanel x:Name="SharedPlcTriggerPanel" Margin="0,8,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PlcUsesPerEnd}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{loc:Text SharedTriggerBit}" Style="{StaticResource Caption}"/>
        <TextBox x:Name="PlcTriggerAddressTextBox" Text="{Binding PlcTriggerAddress,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" ToolTip="{loc:Text PlcBitAddressHint}"/>
       </StackPanel>
       <Grid x:Name="PerEndPlcTriggerPanel" Margin="0,8,0,0" Visibility="{Binding PlcUsesPerEnd,Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Text End1Bit}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{loc:Text End2Bit}" Style="{StaticResource Caption}"/>
        <TextBox Grid.Row="1" x:Name="PlcEnd1AddressTextBox" Text="{Binding PlcEnd1Address,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="PlcEnd2AddressTextBox" Text="{Binding PlcEnd2Address,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
       </Grid>
      </StackPanel>
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,20,0,20"/>
      <TextBlock Text="{loc:Text Output}" Style="{StaticResource SectionLabel}"/>
      <TextBlock Text="{loc:Text OutputHelp}" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
      <Border BorderBrush="{StaticResource Brush.Status.Success}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8" Margin="0,0,0,8" IsEnabled="{Binding CanEditRecipeIo}">
       <StackPanel>
        <CheckBox Content="{loc:Text OkOutput}" IsChecked="{Binding OkOutputEnabled}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Success}"/>
        <Grid IsEnabled="{Binding OkOutputEnabled}" Margin="0,6,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="{loc:Text OutputType}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{loc:Text DeviceArea}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="4" Text="{loc:Text Index}" Style="{StaticResource Caption}"/>
         <ComboBox x:Name="OkOutputModeSelector" Grid.Row="1" ItemsSource="{Binding PlcOutputModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OkOutputMode}" Style="{StaticResource Input.Combo}"/><ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding OkOutputDevices}" SelectedItem="{Binding OkOutputDevice}" Style="{StaticResource Input.Combo}"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding OkOutputIndex,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
         <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Text" Value="{loc:Text RegisterValue}"/><Style.Triggers><DataTrigger Binding="{Binding OkUsesBit}" Value="True"><Setter Property="Text" Value="{loc:Text PulseResetMs}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <Grid Grid.Row="3" Grid.ColumnSpan="5">
          <TextBox Text="{Binding OkOutputPulseMs,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" Visibility="{Binding OkUsesBit,Converter={StaticResource BoolToVisibility}}"/>
          <TextBox Text="{Binding OkOutputValue,UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource TextEditor}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding OkUsesBit}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
         </Grid>
        </Grid>
       </StackPanel>
      </Border>
      <Border BorderBrush="{StaticResource Brush.Status.Error}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8" IsEnabled="{Binding CanEditRecipeIo}">
       <StackPanel>
        <CheckBox Content="{loc:Text NgOutput}" IsChecked="{Binding NgOutputEnabled}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Error}"/>
        <Grid IsEnabled="{Binding NgOutputEnabled}" Margin="0,6,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="{loc:Text OutputType}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{loc:Text DeviceArea}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="4" Text="{loc:Text Index}" Style="{StaticResource Caption}"/>
         <ComboBox x:Name="NgOutputModeSelector" Grid.Row="1" ItemsSource="{Binding PlcOutputModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NgOutputMode}" Style="{StaticResource Input.Combo}"/><ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding NgOutputDevices}" SelectedItem="{Binding NgOutputDevice}" Style="{StaticResource Input.Combo}"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding NgOutputIndex,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}"/>
         <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Text" Value="{loc:Text RegisterValue}"/><Style.Triggers><DataTrigger Binding="{Binding NgUsesBit}" Value="True"><Setter Property="Text" Value="{loc:Text PulseResetMs}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <Grid Grid.Row="3" Grid.ColumnSpan="5">
          <TextBox Text="{Binding NgOutputPulseMs,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" Visibility="{Binding NgUsesBit,Converter={StaticResource BoolToVisibility}}"/>
          <TextBox Text="{Binding NgOutputValue,UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource TextEditor}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding NgUsesBit}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
         </Grid>
        </Grid>
       </StackPanel>
      </Border>
      <TextBlock x:Name="TriggerStatusText" Text="{Binding TriggerStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <TextBlock Text="{loc:Text TriggerRunHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,20,0,20"/>
      <TextBlock Text="{loc:Text InspectionModules}" Style="{StaticResource SectionLabel}"/>
      <CheckBox Content="{loc:Text OcrText}" IsChecked="True" IsEnabled="False" Margin="0,0,0,10"/>
      <CheckBox Content="{loc:Text WireColor}" IsEnabled="False" Margin="0,0,0,10"/>
      <CheckBox Content="{loc:Text TerminalTemplate}" IsEnabled="False"/>
      <TextBlock Text="{loc:Text NotImplemented}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
   </Grid>
   <Grid x:Name="ModelWorkspaceGrid" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="ModelSelectionPanel" Grid.Row="1" Margin="0,0,0,12" Background="{StaticResource Brush.Background.Selected}" BorderThickness="2" CornerRadius="{StaticResource Radius.MD}" Padding="12,8">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Warning}"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedModel}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Secondary}"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{loc:Text OperatingModel}" Style="{StaticResource SectionLabel}"/>
       <TextBlock x:Name="SelectedModelCodeText" Text="{Binding SelectedModelCode}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding SelectedModelName}" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
       <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedModelRevision}" Style="{StaticResource Caption}" Margin="0,0,8,0"/><TextBlock Text="{loc:Text ReadyToRun}" Foreground="{StaticResource Brush.Status.Success}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedModel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
      </StackPanel>
      <ComboBox x:Name="ModelSelector" Grid.Column="2" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Code" IsEnabled="{Binding CanSelectModel}" Style="{StaticResource Input.Combo}" ToolTip="{loc:Text ChooseModel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button x:Name="AddModelButton" Grid.Column="3" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Plus}" ToolTip="{loc:Text AddModel}" AutomationProperties.Name="{loc:Text AddModel}" Click="AddModel" IsEnabled="{Binding CanCreateModel}" VerticalAlignment="Center"/>
      <Button x:Name="EditModelButton" Grid.Column="4" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Edit}" ToolTip="{loc:Text EditModel}" AutomationProperties.Name="{loc:Text EditModel}" Click="EditModel" IsEnabled="{Binding CanManageSelectedModel}" VerticalAlignment="Center"/>
      <Button x:Name="DeleteModelButton" Grid.Column="5" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Delete}" ToolTip="{loc:Text DeleteModel}" AutomationProperties.Name="{loc:Text DeleteModel}" Command="{Binding DeleteModelCommand}" IsEnabled="{Binding CanManageSelectedModel}" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Grid x:Name="ModelSetupEditors" Grid.Row="2" IsEnabled="{Binding CanConfigureModel}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <views:EndEditorView x:Name="FirstEndEditor" DataContext="{Binding End1}" Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"/>
     <views:EndEditorView x:Name="SecondEndEditor" Grid.Column="2" DataContext="{Binding End2}" Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
   </Grid>
   <Border x:Name="ModelLibraryPanel" Grid.Column="4" Style="{StaticResource Panel}" IsEnabled="{Binding IsAdmin}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding ModelCount}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBlock x:Name="UnsavedNotification" Text="{loc:Text NeedSave}" Foreground="{StaticResource Brush.Status.Error}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8" Visibility="{Binding Dirty,Converter={StaticResource BoolToVisibility}}"/><Button x:Name="SaveRecipeButton" Tag="{StaticResource Icon.Save}" ToolTip="{loc:Text SaveRecipe}" AutomationProperties.Name="{loc:Text SaveRecipe}" Command="{Binding SaveRecipeCommand}" IsEnabled="{Binding CanSaveRecipe}" Margin="0,0,0,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolRail.Button}"><Style.Triggers><DataTrigger Binding="{Binding Dirty}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Brand.Secondary}"/><Setter Property="Background" Value="{StaticResource Brush.Background.Selected}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><TextBlock Text="{loc:Text ModelLibrary}" Style="{StaticResource SectionLabel}"/></DockPanel>
      <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextEditor}" ToolTip="{loc:Text SearchModel}" Margin="0,4,0,12"/>
     </StackPanel>
     <DataGrid x:Name="ModelLibraryGrid" ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}" IsReadOnly="True" AutoGenerateColumns="False"
      EnableRowVirtualization="True" RowHeight="116" IsEnabled="{Binding CanSelectModel}">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="{loc:Text Model}" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Code}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Revision}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="{loc:Text OcrEnd1}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><Image Source="{Binding First}" Stretch="Uniform" Height="58"/><TextBlock Text="{Binding FirstExpected}" FontFamily="{StaticResource Font.Monospace}" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding FirstExpected}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="{loc:Text OcrEnd2}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><Image Source="{Binding Second}" Stretch="Uniform" Height="58"/><TextBlock Text="{Binding SecondExpected}" FontFamily="{StaticResource Font.Monospace}" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding SecondExpected}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Visibility="{Binding RunPage,Converter={StaticResource BoolToVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
    <DockPanel>
     <Border DockPanel.Dock="Right" Style="{StaticResource Hud.Container}" Padding="4"><StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.OpenImage}" ToolTip="{loc:Text LoadOfflineImage}" AutomationProperties.Name="{loc:Text LoadOfflineImage}" Command="{Binding LoadRuntimeCommand}" IsEnabled="{Binding CanCapture}"/>
      <Button Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Camera}" ToolTip="{Binding CaptureLabel}" AutomationProperties.Name="Capture runtime image" Command="{Binding ManualTriggerCommand}" IsEnabled="{Binding CanCapture}"/>
      <Button x:Name="RetakeEndButton" Style="{StaticResource ToolRail.Button}" Tag="{StaticResource Icon.Sync}" ToolTip="{loc:Text RetakeEnd}" AutomationProperties.Name="{loc:Text RetakeEnd}" Command="{Binding RetakeEndCommand}"/>
      <Button Style="{StaticResource Button.Secondary}" Content="{loc:Text PreviousResult}" ToolTip="{loc:Text PreviousResultHint}" Command="{Binding TogglePreviousResultsCommand}" IsEnabled="{Binding HasPreviousResult}" Padding="8,4"/>
      <Button x:Name="StopRuntimeButton" Style="{StaticResource ToolRail.DangerButton}" Tag="{StaticResource Icon.Stop}" ToolTip="{loc:Text StopRuntime}" AutomationProperties.Name="{loc:Text StopRuntime}" Command="{Binding StopRunCommand}" IsEnabled="{Binding Running}"/>
     </StackPanel></Border>
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="RunStatusText" Text="{Binding RunStatus}" Style="{StaticResource RunStatusLabel}" VerticalAlignment="Center" Margin="0,0,24,0"/>
      <TextBlock Text="{Binding LastProductVerdict}" FontSize="40" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" Visibility="{Binding HasPreviousResult,Converter={StaticResource BoolToVisibility}}">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/><Style.Triggers><DataTrigger Binding="{Binding LastProductVerdict}" Value="NG"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger><DataTrigger Binding="{Binding LastProductVerdict}" Value="ERROR"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <Border x:Name="RunningModelPanel" Background="{StaticResource Brush.Background.Selected}" BorderBrush="{StaticResource Brush.Brand.Secondary}" BorderThickness="2" CornerRadius="{StaticResource Radius.MD}" Padding="12,5" VerticalAlignment="Center" Margin="0,0,24,0">
       <StackPanel MinWidth="190"><TextBlock Text="{loc:Text RunningModel}" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding ActiveModel}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding ActiveModelName}" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CycleLabel}" Style="{StaticResource Caption}"/></StackPanel>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
        <TextBlock Text="{Binding RunCameraStatus}" Foreground="{StaticResource Brush.Brand.Primary}" FontWeight="SemiBold" Margin="0,0,14,0"/>
        <TextBlock Text="{Binding RunPlcStatus}" Foreground="{StaticResource Brush.Status.Success}" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="RunTriggerText" Text="{Binding LastTrigger}" Style="{StaticResource Caption}"/>
       <TextBlock x:Name="CycleTimingText" Text="{Binding CycleTimingText}" Style="{StaticResource Caption}"/>
       <TextBlock x:Name="RunAcquisitionSummaryText" Text="{Binding AcquisitionSummary}" Style="{StaticResource Caption}"/>
      </StackPanel>
     </StackPanel>
    </DockPanel>
   </Border>
    <Grid Grid.Row="1">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding PreviousResultLabel}" Foreground="{StaticResource Brush.Status.Warning}" FontWeight="SemiBold" Margin="0,0,0,6" Visibility="{Binding ShowPreviousResults,Converter={StaticResource BoolToVisibility}}"/>
     <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <views:EndResultView x:Name="FirstEndResult" DataContext="{Binding DisplayResult1}"/>
     <views:EndResultView x:Name="SecondEndResult" Grid.Column="2" DataContext="{Binding DisplayResult2}"/>
     </Grid>
    </Grid>
  </Grid>
  <Border Grid.Row="3" Padding="4,10,4,0">
   <DockPanel>
    <TextBlock Text="{Binding Message}" Style="{StaticResource StatusMessage.Attention}" MaxHeight="52"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
