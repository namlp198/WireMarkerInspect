<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><OutputType>WinExe</OutputType>
    <MvsManagedSdkPath Condition="Exists('../../vendor/camera/MvCameraControl.Net.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../vendor/camera/MvCameraControl.Net.dll'))</MvsManagedSdkPath>
    <MvsManagedSdkPath Condition="'$(MvsManagedSdkPath)' == '' and Exists('$(MSBuildProgramFiles32)/MVS/Development/DotNet/AnyCpu/MvCameraControl.Net.dll')">$(MSBuildProgramFiles32)/MVS/Development/DotNet/AnyCpu/MvCameraControl.Net.dll</MvsManagedSdkPath>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../WireMarkerInspection.Domain/WireMarkerInspection.Domain.csproj" /><ProjectReference Include="../WireMarkerInspection.Application/WireMarkerInspection.Application.csproj" /><ProjectReference Include="../WireMarkerInspection.Infrastructure/WireMarkerInspection.Infrastructure.csproj" /><ProjectReference Include="../WireMarkerInspection.Vision/WireMarkerInspection.Vision.csproj" /><ProjectReference Include="../WireMarkerInspection.Controls/WireMarkerInspection.Controls.csproj" /><PackageReference Include="CommunityToolkit.Mvvm" /></ItemGroup>
  <ItemGroup><Reference Include="MvCameraControl.Net" HintPath="$(MvsManagedSdkPath)" Private="true" Condition="'$(MvsManagedSdkPath)' != ''" /></ItemGroup>
  <ItemGroup><Content Include="../../build/native/Release/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="../../assets/ocr/*" Link="assets/ocr/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="../../vendor/camera/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../../assets/licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
