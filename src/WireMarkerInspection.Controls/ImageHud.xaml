<UserControl x:Class="WireMarkerInspection.Controls.ImageHud" x:Name="Hud"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid ClipToBounds="True" Background="{DynamicResource Brush.Background.App}">
  <!-- Image owns the entire viewport; HUD siblings never change its transform. -->
  <ContentPresenter Content="{Binding Viewer,ElementName=Hud}"/>
  <Border x:Name="CaptionPanel" Style="{DynamicResource Hud.Container}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{DynamicResource Hud.Inset}" Padding="8,4" IsHitTestVisible="False">
   <StackPanel>
    <TextBlock Text="{Binding Caption,ElementName=Hud}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12" FontWeight="SemiBold"/>
    <TextBlock x:Name="ImageInfo" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
   </StackPanel>
  </Border>
  <Border x:Name="ExpandPanel" Style="{DynamicResource Hud.Container}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource Hud.Inset}" Visibility="Collapsed">
   <Button Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Expand}" Click="Expand" ToolTip="Phóng lớn ảnh" AutomationProperties.Name="Expand image"/>
  </Border>
  <Border x:Name="DrawingRail" Style="{DynamicResource Overlay.ToolRail}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{DynamicResource Hud.Inset}" Visibility="Collapsed">
   <StackPanel Margin="{DynamicResource Hud.RailPadding}">
    <ToggleButton x:Name="SelectButton" Style="{DynamicResource ToolRail.ToggleButton}" Tag="{DynamicResource Icon.Select}" Uid="Select" Click="SelectTool" ToolTip="Chọn / di chuyển / sửa ROI" AutomationProperties.Name="Select ROI"/>
    <ToggleButton x:Name="RectangleButton" Style="{DynamicResource ToolRail.ToggleButton}" Tag="{DynamicResource Icon.MeasureRectangle}" Uid="Rectangle" Click="SelectTool" ToolTip="Vẽ ROI chữ nhật" AutomationProperties.Name="Rectangle ROI"/>
    <ToggleButton x:Name="CircleButton" Style="{DynamicResource ToolRail.ToggleButton}" Tag="{DynamicResource Icon.MeasureCircle}" Uid="Circle" Click="SelectTool" ToolTip="Vẽ ROI tròn" AutomationProperties.Name="Circle ROI"/>
    <ToggleButton x:Name="PolygonButton" Style="{DynamicResource ToolRail.ToggleButton}" Tag="{DynamicResource Icon.MeasurePolygon}" Uid="Polygon" Click="SelectTool" ToolTip="Vẽ ROI polygon · Enter để hoàn tất" AutomationProperties.Name="Polygon ROI"/>
    <ToggleButton x:Name="PanButton" Style="{DynamicResource ToolRail.ToggleButton}" Tag="{DynamicResource Icon.Pan}" Uid="Pan" Click="SelectTool" ToolTip="Pan · hoặc giữ Space / chuột giữa rồi kéo" AutomationProperties.Name="Pan image"/>
    <Border Style="{DynamicResource Hud.Separator}"/>
    <Button x:Name="UndoButton" Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Undo}" Click="Undo" ToolTip="Undo · Ctrl+Z" AutomationProperties.Name="Undo ROI"/>
    <Button x:Name="RedoButton" Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Redo}" Click="Redo" ToolTip="Redo · Ctrl+Y" AutomationProperties.Name="Redo ROI"/>
    <Button x:Name="DeleteButton" Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Delete}" Click="Delete" ToolTip="Xóa ROI · Delete" AutomationProperties.Name="Delete ROI"/>
   </StackPanel>
  </Border>
  <Border x:Name="PolygonStrip" Style="{DynamicResource Hud.Container}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,66,12,0" Padding="4" Visibility="Collapsed">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="FinishButton" Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Check}" Click="Finish" ToolTip="Hoàn tất polygon · Enter" AutomationProperties.Name="Finish polygon"/>
    <Button Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Undo}" Click="UndoPoint" ToolTip="Xóa điểm cuối · Backspace" AutomationProperties.Name="Undo polygon point"/>
    <Button Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.Close}" Click="Cancel" ToolTip="Hủy nét vẽ · Escape" AutomationProperties.Name="Cancel drawing"/>
   </StackPanel>
  </Border>
  <Border x:Name="NavigationHud" Style="{DynamicResource Hud.Container}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{DynamicResource Hud.Inset}" Padding="{DynamicResource Hud.RailPadding}">
   <StackPanel x:Name="NavigationButtons" Orientation="Horizontal">
    <Button Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.ZoomOut}" Click="ZoomOut" ToolTip="Thu nhỏ · cuộn chuột" AutomationProperties.Name="Zoom out"/>
    <Button Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.ZoomIn}" Click="ZoomIn" ToolTip="Phóng to · cuộn chuột" AutomationProperties.Name="Zoom in"/>
    <Button x:Name="ResetViewButton" Style="{DynamicResource ToolRail.Button}" Tag="{DynamicResource Icon.ActualSize}" Click="ResetView" ToolTip="Về khung mặc định khi load ảnh · Fit" AutomationProperties.Name="Reset image to default fit"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
